generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                             String    @id @default(cuid())
  shop                           String    @unique
  accessToken                    String?
  grantedScopes                  String?   @map("scope")
  tokenAcquisitionMode           String?   @default("offline_expiring")
  isOffline                      Boolean   @default(true)
  installedAt                    DateTime?
  reauthorizedAt                 DateTime?
  webhooksRegisteredAt           DateTime?
  lastWebhookRegistrationStatus  String?
  lastConnectionCheckAt          DateTime?
  lastConnectionStatus           String?
  lastConnectionError            String?
  authErrorCode                  String?
  authErrorMessage               String?
  accessTokenExpiresAt           DateTime?
  refreshToken                   String?
  refreshTokenExpiresAt          DateTime?
  uninstalledAt                  DateTime?
  lastSyncAt                     DateTime?
  lastSyncStatus                 String?   @map("syncStatus")
  onboardingCompletedAt          DateTime?
  onboardingDismissedAt          DateTime?
  onboardingSelectedModule       String?
  onboardingFirstInsightViewedAt DateTime?
  onboardingPlanConfirmedAt      DateTime?

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  fraudSensitivity   String  @default("medium")
  sharedFraudNetwork Boolean @default(false)
  pricingBias        Int     @default(55)
  profitGuardrail    Int     @default(18)

  subscription StoreSubscription? @relation("StoreToSubscription")

  competitorDomains    CompetitorDomain[]
  productSnapshots     ProductSnapshot[]
  orders               Order[]
  customers            Customer[]
  fraudSignals         FraudSignal[]
  competitorData       CompetitorData[]
  priceHistory         PriceHistory[]
  profitData           ProfitOptimizationData[]
  billingAuditLogs     BillingAuditLog[]
  billingPlanIntents   BillingPlanIntent[]
  timelineEvents       TimelineEvent[]
  syncJobs             SyncJob[]
  supportTickets       SupportTicket[]
  intelligenceFindings IntelligenceFinding[]
  reconciliationRuns   ReconciliationRun[]
  reconciliationSources ReconciliationSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Immutable, durable record of a shop's one-time trial grant — independent
/// of the Store row's lifecycle.
///
/// Store rows are hard-deleted (`prisma.store.delete`, see
/// privacyService.deleteStoreCompletely) on Shopify's shop/redact webhook or
/// the retention-sweep backstop, cascading away trialStartedAt/trialEndsAt
/// with everything else. Without a separate record, a shop that uninstalls,
/// is purged, and reinstalls later would look like a genuine first
/// installation and receive a second trial.
///
/// Deliberately has NO relation/foreign key to Store, so it is never
/// touched by Store's ON DELETE CASCADE and survives a full data purge. It
/// holds no customer or order data — only the shop's own domain and trial
/// timestamps — so retaining it through a redaction is a legitimate
/// trial-abuse-prevention record, not personal data subject to erasure.
///
/// Written exactly once per shop, on genuine first installation. Never
/// updated or deleted by any code path in this app.
model ShopTrialHistory {
  id               String   @id @default(cuid())
  shop             String   @unique
  firstInstalledAt DateTime
  trialStartedAt   DateTime
  trialEndsAt      DateTime
  createdAt        DateTime @default(now())
}

model ProductSnapshot {
  id               String   @id @default(cuid())
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId          String
  shopifyProductId String
  handle           String
  title            String
  status           String   @default("active")
  variantCount     Int      @default(0)
  currentPrice     Float?
  currency         String?
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants VariantSnapshot[]

  @@unique([storeId, shopifyProductId])
  @@index([storeId, handle])
}

model VariantSnapshot {
  id                String          @id @default(cuid())
  product           ProductSnapshot @relation(fields: [productSnapshotId], references: [id], onDelete: Cascade)
  productSnapshotId String
  shopifyVariantId  String
  title             String
  price             Float
  currency          String?
  /// Merchant-assigned stock keeping unit. NULL when the merchant has not set
  /// one in Shopify - which is common, and is why reconciliation treats a
  /// missing SKU as unmatchable rather than guessing at a title match.
  sku               String?
  /// Shopify inventory on hand at sync time. NULL means Shopify did not report
  /// a tracked quantity, NOT zero. The distinction matters: a null must never
  /// be reconciled against a warehouse count as though Shopify had said 0.
  inventoryQuantity Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productSnapshotId, shopifyVariantId])
}

model SubscriptionPlan {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float
  // Matches env.billing.trialDays (BILLING_PLAN_TRIAL_DAYS, default 7) — the
  // single runtime source of truth for trial length. This default only
  // matters if a row is ever created without explicitly setting trialDays;
  // every current code path does set it explicitly.
  trialDays Int      @default(7)
  features  String // JSON string describing enabled modules
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions StoreSubscription[]
}

model StoreSubscription {
  id                            String           @id @default(cuid())
  store                         Store            @relation("StoreToSubscription", fields: [storeId], references: [id], onDelete: Cascade)
  storeId                       String           @unique
  plan                          SubscriptionPlan @relation(fields: [planId], references: [id])
  planId                        String
  starterModule                 String?
  shopifyChargeId               String? // link to Shopify Billing
  active                        Boolean          @default(true)
  billingStatus                 String           @default("ACTIVE")
  startedAt                     DateTime         @default(now())
  planActivatedAt               DateTime         @default(now())
  cancelledAt                   DateTime?
  endsAt                        DateTime?
  lastBillingSyncAt             DateTime?
  lastBillingWebhookProcessedAt DateTime?
  lastBillingResolutionSource   String?
  lastBillingSubscriptionName   String?
  moduleSwitchedAt              DateTime?

  auditLogs BillingAuditLog[]
}

model BillingAuditLog {
  id                    String             @id @default(cuid())
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId               String
  subscription          StoreSubscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId        String?
  eventType             String
  previousPlanName      String?
  nextPlanName          String?
  previousStarterModule String?
  nextStarterModule     String?
  billingStatus         String?
  metadataJson          String?
  createdAt             DateTime           @default(now())
}

model BillingPlanIntent {
  id                     String    @id @default(cuid())
  store                  Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId                String
  requestedPlanName      String
  requestedStarterModule String?
  actionType             String
  status                 String    @default("CREATING")
  confirmationUrl        String?
  shopifyChargeId        String?
  host                   String?
  returnPath             String?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  expiresAt              DateTime?

  @@index([storeId, status, createdAt])
}

model Customer {
  id                 String   @id @default(cuid())
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId            String
  shopifyCustomerId  String
  email              String?
  totalOrders        Int      @default(0)
  totalRefunds       Int      @default(0)
  refundRate         Float    @default(0)
  fraudSignalsCount  Int      @default(0)
  paymentReliability Float    @default(0)
  creditScore        Int      @default(50)
  creditCategory     String   @default("Normal Buyer")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders         Order[]
  fraudSignals   FraudSignal[]
  timelineEvents TimelineEvent[]
}

model Order {
  id                   String    @id @default(cuid())
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId              String
  customer             Customer? @relation(fields: [customerId], references: [id])
  customerId           String?
  shopifyOrderId       String    @unique
  shopifyOrderGid      String?
  shopifyLegacyOrderId String?
  orderName            String?
  totalAmount          Float
  currency             String
  fraudScore           Int       @default(0)
  fraudRiskLevel       String    @default("Low")
  refundRequested      Boolean   @default(false)
  refunded             Boolean   @default(false)
  status               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  fraudSignals   FraudSignal[]
  timelineEvents TimelineEvent[]

  @@index([shopifyOrderGid])
  @@index([storeId, shopifyLegacyOrderId])
  @@index([storeId, orderName])
}

model FraudSignal {
  id         String    @id @default(cuid())
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId    String
  order      Order?    @relation(fields: [orderId], references: [id])
  orderId    String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  ipAddress          String?
  email              String?
  shippingAddress    String?
  deviceFingerprint  String?
  paymentFingerprint String?
  refundHistory      String?
  orderFrequency     String?

  riskScore         Int     @default(0)
  riskLevel         String  @default("Low")
  sharedNetworkHash String?

  createdAt DateTime @default(now())
}

model CompetitorDomain {
  /// Outcome of the most recent collection attempt. One of the
  /// CompetitorFetchStatus values; NULL means never attempted. Persisted so the
  /// UI never has to INFER why a domain has no fresh data.
  lastAttemptAt     DateTime?
  lastAttemptStatus String?
  /// Technical detail for logs and support. Never shown to merchants.
  lastAttemptDetail String?
  /// When this domain last yielded usable data, whatever happened since.
  lastSuccessAt     DateTime?
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  domain    String
  label     String?
  createdAt DateTime @default(now())
}

model CompetitorData {
  id             String   @id @default(cuid())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId        String
  productHandle  String
  competitorName String
  competitorUrl  String
  source         String // website | google_shopping | meta_ads
  price          Float?
  promotion      String?
  stockStatus    String?
  adCopy         String?
  insightsJson   String? // AI-generated insights
  collectedAt    DateTime @default(now())
}

model PriceHistory {
  id                  String   @id @default(cuid())
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId             String
  productHandle       String
  currentPrice        Float
  recommendedPrice    Float
  expectedMarginDelta Float
  expectedProfitGain  Float?
  rationaleJson       String? // AI explanation
  createdAt           DateTime @default(now())
}

model ProfitOptimizationData {
  id                      String   @id @default(cuid())
  store                   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId                 String
  productHandle           String
  /// NULL means unknown. VedaSuite has no Shopify product-cost feed, so a
  /// value here is only trustworthy when costSource = "observed".
  productCost             Float?
  /// "observed" | "assumed". Gates whether productCost may support a
  /// merchant-facing monetary claim. Defaults to assumed — never optimistic.
  costSource              String   @default("assumed")
  /// "observed" | "assumed". Per-product velocity is not derivable today
  /// (there are no order line items), so this is "assumed" in practice.
  velocitySource          String   @default("assumed")
  sellingPrice            Float
  competitorAveragePrice  Float?
  advertisingSpend        Float?
  shippingCost            Float?
  returnRate              Float?
  salesVelocity           Float?
  optimalPrice            Float?
  projectedMarginIncrease Float?
  projectedMonthlyProfit  Float?
  bundleSuggestionsJson   String?
  discountStrategyJson    String?
  createdAt               DateTime @default(now())
}

model TimelineEvent {
  id           String    @id @default(cuid())
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId      String
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   String?
  order        Order?    @relation(fields: [orderId], references: [id])
  orderId      String?
  category     String
  eventType    String
  title        String
  detail       String
  severity     String    @default("info")
  scoreImpact  Int?
  metadataJson String?
  createdAt    DateTime  @default(now())

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
}

model SyncJob {
  id            String    @id @default(cuid())
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       String
  jobType       String
  triggerSource String
  status        String    @default("PENDING")
  summaryJson   String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

model SupportTicket {
  id            String    @id @default(cuid())
  // onDelete: Cascade so a shop/redact erases the merchant's tickets with the
  // rest of their data — a ticket holds the merchant's message and optional
  // contact email, which is personal data.
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       String
  // Denormalized shop domain for the admin list view. Erased with the row.
  shop          String
  subject       String
  category      String    @default("general")
  message       String
  contactEmail  String?
  // OPEN | IN_PROGRESS | RESOLVED
  status        String    @default("OPEN")
  adminResponse String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

/// Persisted envelope around a computed intelligence finding.
///
/// This model deliberately stores NONE of the analytical semantics. Severity
/// (`Urgency`), `Confidence`, `FinancialImpact`, `AggregateEvidence`,
/// `Methodology`, `recommendedAction` and data coverage all remain owned by
/// services/explainabilityCalc.ts + explainabilityService.ts, which are the
/// single source of truth and are recomputed on read. Re-declaring any of them
/// here would create a second, drifting definition.
///
/// What it adds is exactly what a per-request computation cannot provide:
/// identity that survives across runs (`fingerprint`), merchant ownership,
/// lifecycle state, and first/last-seen timestamps — the prerequisites for a
/// later Action Center.
///
/// Cascades with the Store row, so a shop/redact purge removes it along with
/// the derived data it describes.
model IntelligenceFinding {
  id      String @id @default(cuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  /// Stable, caller-supplied identity for "the same finding, seen again".
  /// Unique per store (see @@unique) so repeated detection updates one row
  /// instead of accumulating duplicates. Never derived from volatile values
  /// such as money amounts or timestamps.
  fingerprint String

  /// Which analysis produced this. Holds an existing `InsightModule` value
  /// ("fraud" | "trust" | "return_abuse" | "competitor" | "pricing" | "profit")
  /// as a plain string rather than a new enum, so the taxonomy stays owned by
  /// explainabilityCalc.ts and adding a module needs no migration.
  module String

  /// Finer-grained detector key within a module, for later detectors to
  /// distinguish their own finding kinds without a schema change.
  findingType String

  /// Reference back to the computed ExplainableInsight.id this envelope last
  /// wrapped. A pointer for correlation only — not a foreign key, because the
  /// computed insight is not persisted anywhere.
  sourceInsightId String?

  /// Lifecycle: new | seen | in_review | resolved | dismissed.
  /// A plain string with an application-level whitelist, matching the existing
  /// convention on SupportTicket.status and SyncJob.status.
  status String @default("new")

  /// Freshness. firstDetectedAt is written once and never moved; lastSeenAt
  /// advances on every re-detection, so "how long has this been true" and
  /// "is this still true" are both answerable.
  firstDetectedAt DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  /// How many times this finding has been re-detected. Minimal persisted
  /// signal for later prioritisation ("recurring" vs "one-off").
  detectionCount Int @default(1)

  /// Resolution / dismissal metadata.
  statusChangedAt DateTime?
  resolvedAt      DateTime?
  dismissedAt     DateTime?
  resolutionNote  String?
  /// Free-form actor label (e.g. "merchant"). No PII is written here.
  statusChangedBy String?

  /// Last-seen serialization of the computed ExplainableInsight, kept so a
  /// resolved or no-longer-emitted finding can still be displayed. A read-only
  /// snapshot: never hand-edited, never treated as authoritative, and always
  /// superseded by a fresh computation when one is available.
  ///
  /// Written ONLY through intelligenceFindingService.sanitizeSnapshotForPersistence,
  /// which allow-lists the known ExplainableInsight fields (so a detector cannot
  /// smuggle in raw customer data), drops the redundant storeId, masks email and
  /// long-digit-run patterns in free text, and bounds string/array/total size to
  /// MAX_SNAPSHOT_BYTES. Over-budget payloads are reduced to a renderable
  /// minimum rather than stored truncated. Never write this column directly.
  snapshotJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, fingerprint])
  @@index([storeId, status, lastSeenAt])
  @@index([storeId, module, status])
}

// ============================================================================
// RECONCILIATION
//
// ONE engine, three check types. The tables below are deliberately generic:
// nothing here names inventory, 3PL or suppliers, because a fourth check type
// must not need a fifth table.
//
// Everything is store-scoped and cascades from Store, matching the isolation
// and deletion behaviour every other model in this schema already has.
// ============================================================================

/// One uploaded operational file, plus the mapping the merchant confirmed for
/// it. Rows are held on the source rather than the run so the same upload can
/// be reconciled again without re-uploading.
model ReconciliationSource {
  id      String @id @default(cuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  /// "inventory" | "3pl_invoice" | "supplier_shipment". A plain string with an
  /// application-level whitelist, matching the SyncJob.status convention.
  checkType String

  /// Sanitized display name. Path separators and control characters are
  /// stripped before this is written; the original is never stored, and no
  /// filesystem path is recorded anywhere because the file itself is not kept.
  fileName String
  /// "csv" | "xlsx".
  fileFormat String
  fileSizeBytes Int

  /// Lifecycle: uploaded | validating | needs_mapping | ready | reconciling |
  /// completed | failed. A partially processed upload is never "completed".
  status String @default("uploaded")
  /// Merchant-facing explanation when status is failed or needs_mapping.
  statusReason String?

  /// Headers exactly as they appeared in the file.
  headersJson String?
  /// Confirmed column mapping: { sku: "Item SKU", quantity: "Available" }.
  /// Written only after the merchant confirms; a low-confidence guess is
  /// offered as a suggestion and never persisted as a decision.
  mappingJson String?

  /// Counts from validation. Reported before a run may be committed.
  totalRows     Int @default(0)
  validRows     Int @default(0)
  invalidRows   Int @default(0)
  duplicateRows Int @default(0)

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  records ReconciliationRecord[]
  runs    ReconciliationRun[]

  @@index([storeId, checkType, uploadedAt])
  @@index([storeId, status])
}

/// One normalized row from an uploaded file.
///
/// Deliberately narrow. Reconciliation works on identifiers, quantities and
/// amounts; it does not need customer identity, so no name, email, address or
/// phone column exists here to put one in.
model ReconciliationRecord {
  id       String               @id @default(cuid())
  source   ReconciliationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String
  /// Denormalized for query isolation: every read filters on storeId directly
  /// rather than trusting a join to enforce ownership.
  storeId  String

  /// 1-based line number in the merchant's own file, so evidence can point at
  /// the row they can actually go and look at.
  rowNumber Int

  sku        String?
  orderRef   String?
  tracking   String?
  location   String?
  quantity   Float?
  amount     Float?
  currency   String?
  /// Timestamp carried by the file itself, when it has one. NULL means the
  /// file did not say, which is why staleness is only ever reported for files
  /// that actually carry a date.
  observedAt DateTime?

  /// Why a row was rejected during validation. NULL for accepted rows.
  invalidReason String?

  createdAt DateTime @default(now())

  @@index([storeId, sourceId])
  @@index([sourceId, sku])
  @@index([sourceId, orderRef])
}

/// One execution of one check type against one source.
model ReconciliationRun {
  id      String @id @default(cuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  source   ReconciliationSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId String?

  checkType String

  /// queued | running | completed | completed_with_warnings | failed.
  /// completed_with_warnings exists so a run that could only partially match is
  /// never displayed as a clean success.
  status String @default("queued")
  /// Merchant-facing reason for a failure or a partial result.
  statusReason String?

  matchedCount      Int @default(0)
  probableCount     Int @default(0)
  unmatchedCount    Int @default(0)
  discrepancyCount  Int @default(0)
  /// Discrepancies VedaSuite could size in money. Never inferred from the
  /// total: a run can find 12 discrepancies and quantify none of them.
  quantifiedCount   Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discrepancies ReconciliationDiscrepancy[]

  @@index([storeId, checkType, startedAt])
  @@index([storeId, status])
}

/// One detected difference, with the evidence that supports it.
model ReconciliationDiscrepancy {
  id      String            @id @default(cuid())
  run     ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId   String
  storeId String

  /// Detector key within the check type, e.g. "quantity_mismatch".
  kind String

  /// confirmed | possible | insufficient_data.
  ///
  /// SEPARATE from matchConfidence on purpose. A real quantity difference found
  /// across a merely PROBABLE match is a possible discrepancy, not a confirmed
  /// one, and the two must never be collapsed into a single number.
  certainty String

  /// exact | probable | unmatched.
  matchConfidence String

  /// SKU, order reference or shipment line this concerns. Used in the finding
  /// fingerprint, so it must be stable across runs.
  subjectKey String

  shopifyValue  String?
  externalValue String?
  difference    Float?

  /// Money, ONLY where a defensible input existed. NULL means not quantified,
  /// which is displayed as "impact not quantified" rather than as zero.
  impactAmount   Float?
  impactCurrency String?
  /// How impactAmount was derived. Required whenever impactAmount is set.
  impactBasis    String?

  /// [{label, value}] pairs, including the merchant's own file row number.
  evidenceJson String?

  /// The IntelligenceFinding this contributed to, for traceability from a
  /// finding back to the exact source row. Pointer only, not a foreign key,
  /// matching IntelligenceFinding.sourceInsightId's convention.
  findingFingerprint String?

  createdAt DateTime @default(now())

  @@index([storeId, runId])
  @@index([runId, kind])
  @@index([storeId, subjectKey])
}
